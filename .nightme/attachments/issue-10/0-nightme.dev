        <div class="grid grid-cols-12 gap-2 px-4 sm:px-6 py-3 border-b border-slate-dark text-[10px] sm:text-xs font-mono text-slate-dark uppercase tracking-wider">
          <div class="col-span-12 sm:col-span-5">Task</div>
          <div class="col-span-7 sm:col-span-4">Execution environment</div>
          <div class="hidden sm:block sm:col-span-3 text-right">Status</div>
