          </div>

        </div>
      </div>
    </div>
  </div>
</section>


<section class="py-16 sm:py-24 bg-night relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,229,255,0.06),transparent_70%)] pointer-events-none"></div>

